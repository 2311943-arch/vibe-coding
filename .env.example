# 비워 두면 Apify를 쓰지 않는 데모 모드입니다(영상 확인 없이 샘플 악보).
# 설정하면 공개 인스타그램 릴스의 영상 주소를 실제로 확인합니다. 토큰은 절대 커밋하지 마세요.
NUXT_APIFY_TOKEN=
NUXT_APIFY_ACTOR_ID=apify~instagram-scraper
NUXT_APIFY_TIMEOUT_MS=120000

# 작업 저장소(Upstash Redis). 비워 두면 서버 메모리를 씁니다(로컬 개발용).
# Vercel에서는 필수입니다. Vercel Marketplace에서 Upstash Redis를 연결하면 자동으로 들어갑니다. docs/DEPLOY.md 참고.
KV_REST_API_URL=
KV_REST_API_TOKEN=
